# 应用配置
APP_NAME=SuperBizAgent
DEBUG=True
HOST=0.0.0.0
PORT=9900

# 通用 LLM 模型配置 (支持任何 OpenAI 兼容协议: base_url + api_key)
# 留空时会自动回退使用 DASHSCOPE_API_KEY 与通义千问模型
LLM_PROVIDER=openai
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=qwen-max
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# 常见厂商配置示例 (按需切换):
# 1. DeepSeek:
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_API_KEY=sk-xxxx
#   LLM_MODEL=deepseek-chat
# 2. 月之暗面 Moonshot (Kimi):
#   LLM_BASE_URL=https://api.moonshot.cn/v1
#   LLM_API_KEY=sk-xxxx
#   LLM_MODEL=moonshot-v1-8k
# 3. 硅基流动 SiliconFlow:
#   LLM_BASE_URL=https://api.siliconflow.cn/v1
#   LLM_API_KEY=sk-xxxx
#   LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
# 4. 本地 Ollama:
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=qwen2.5:14b

# 阿里云百炼专属配置 (保留用于向量化 Embedding 与重排序 Rerank)
DASHSCOPE_API_KEY=your-dashscope-api-key-here
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# PostgreSQL (pgvector) 配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=super_biz_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=super_biz_password
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10

# RAG 混合检索与重排序超参数
RAG_TOP_K=3
RAG_DENSE_TOP_K=10
RAG_SPARSE_TOP_K=10
RAG_RRF_TOP_K=10
RAG_FINAL_TOP_K=3
RAG_RERANK_MODEL=gte-rerank
RAG_RERANK_THRESHOLD=0.45
RAG_RERANK_ENABLED=True
RAG_MODEL=qwen-max

# 文档分块配置
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# MCP 服务配置
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp

